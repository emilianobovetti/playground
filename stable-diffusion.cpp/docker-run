#!/usr/bin/env sh

set -eux

docker run --rm --init -it \
  --gpus=all \
  --volume="${HOME}/stable-diffusion.cpp:/home/ubuntu/stable-diffusion.cpp" \
  --volume="${HOME}/Desktop/Qwen-Image-Edit-2511:/home/ubuntu/Qwen-Image-Edit-2511" \
  --volume="${HOME}/Desktop/eretum-flyer:/home/ubuntu/eretum-flyer" \
  --workdir=/home/ubuntu/eretum-flyer \
  --env=LD_LIBRARY_PATH=/home/ubuntu/stable-diffusion.cpp/build/bin \
  stable-diffusion.cpp \
  /home/ubuntu/stable-diffusion.cpp/build/bin/sd-cli \
  --diffusion-model /home/ubuntu/Qwen-Image-Edit-2511/qwen-image-edit-2511-Q3_K_M.gguf \
  --vae /home/ubuntu/Qwen-Image-Edit-2511/qwen_image_vae.safetensors \
  --llm /home/ubuntu/Qwen-Image-Edit-2511/Qwen2.5-VL-7B-Instruct.Q5_K_M.gguf \
  --backend te=cuda0,diffusion=cuda0,vae=cpu \
  --params-backend cpu \
  --offload-to-cpu \
  --stream-layers \
  --diffusion-fa \
  --cfg-scale 2.5 \
  --sampling-method euler \
  --max-vram -1 \
  --flow-shift 3 \
  --model-args qwen_image_zero_cond_t=true \
  -v \
  -r "/home/ubuntu/eretum-flyer/Firefly.jpg" \
  -p "Use best practices for a local chess tournament advertisement flyer. Uniform font usage, remove central white line."

